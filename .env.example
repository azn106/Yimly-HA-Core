# ===============================================================================
# Yimly Home Assistant - Environment Configuration Example
# ===============================================================================

# Environment Mode: 'production' or 'development'
APP_ENV="production"

# Port on which the service listens inside the container / host
PORT="3000"

# Persistent Data Storage Directory (default: /data inside Docker, . in local development)
DATA_DIR="/data"

# SQLite / Database Connection URL (default: sqlite+aiosqlite:////data/ha_server.db)
# DATABASE_URL="sqlite+aiosqlite:////data/ha_server.db"

# Public Base URL / Cloudflare Tunnel URL (used for OAuth callbacks and Companion App redirection)
# E.g., BASE_URL="https://yimly.yourdomain.com" or "http://192.168.1.100:3000"
BASE_URL="http://localhost:3000"

# Optional JWT Secret Key (if left empty, a secure 256-bit key is automatically generated and saved in DATA_DIR/jwt_secret.key)
# JWT_SECRET_KEY="your_secure_random_jwt_secret_here"

# Uploads directory for profile pictures
UPLOADS_DIR="/data/uploads"

# Optional Gemini API key if AI assistance features are enabled
GEMINI_API_KEY=""
